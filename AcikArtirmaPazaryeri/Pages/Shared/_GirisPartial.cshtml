@using Microsoft.AspNetCore.Identity
@using AcikArtirmaPazaryeri.Models
@inject SignInManager<Kullanici> SignInManager
@inject UserManager<Kullanici> UserManager

<div class="hesap-menu d-flex align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var kullanici = await UserManager.GetUserAsync(User);
        <a class="menu-link" asp-page="/Hesap/Profil" title="Profilim">@kullanici?.Ad @kullanici?.Soyad</a>
        <form method="post" asp-page="/Hesap/Cikis" class="d-inline m-0">
            <button type="submit" class="btn btn-sm btn-outline-light">Çıkış</button>
        </form>
    }
    else
    {
        <a class="menu-link" asp-page="/Hesap/Giris">Giriş Yap</a>
        <a class="btn btn-sm btn-warning fw-semibold" asp-page="/Hesap/Kayit">Kayıt Ol</a>
    }
</div>
