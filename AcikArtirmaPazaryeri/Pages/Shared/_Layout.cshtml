<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Açık Artırma Pazaryeri</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcikArtirmaPazaryeri.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var aktifSayfa = ViewContext.RouteData.Values["page"]?.ToString();
    }
    <header class="site-header">
        <div class="site-container header-row">
            <a class="logo" asp-page="/Index">
                <span class="logo-beyaz">Açık Artırma</span>
                <span class="logo-vurgu">Pazaryeri</span>
            </a>
            <nav class="ana-menu" aria-label="Ana menü">
                <a class="menu-link @(aktifSayfa == "/Index" ? "aktif" : "")" asp-page="/Index"
                   aria-current="@(aktifSayfa == "/Index" ? "page" : null)">Ana Sayfa</a>
                <a class="menu-link" href="#">Müzayedeler</a>
            </nav>
            <partial name="_GirisPartial" />
        </div>
    </header>

    <main class="site-main">
        <div class="site-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container footer-row">
            <div class="footer-sol">
                <div class="logo logo-kucuk">
                    <span class="logo-beyaz">Açık Artırma</span>
                    <span class="logo-vurgu">Pazaryeri</span>
                </div>
                <div class="mono">BLM4581 Ağ Tabanlı Teknolojiler ve Uygulamaları — Dönem Projesi</div>
            </div>
            <div class="footer-sag mono">
                <span>&copy; 2026 Kaan Yorgun</span>
                <a class="footer-link" href="https://github.com/kaany43/AcikArtirmaPazaryeri">GitHub</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
