<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Açık Artırma Pazaryeri</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcikArtirmaPazaryeri.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var aktifSayfa = ViewContext.RouteData.Values["page"]?.ToString();
    }
    <header class="site-header">
        <div class="site-container header-row">
            <a class="logo" asp-page="/Index" aria-label="Açık Artırma Pazaryeri, ana sayfa">
                <svg class="logo-delik" aria-hidden="true" viewBox="0 0 24 60"><path fill-rule="evenodd" d="M24 0H9L0 9V51L9 60H24ZM9 30a4.5 4.5 0 1 0 9 0a4.5 4.5 0 1 0 -9 0Z" /></svg>
                <span class="logo-govde" aria-hidden="true">Açık Artırma</span>
                <span class="logo-kocan" aria-hidden="true">Pazaryeri</span>
            </a>
            <button type="button" class="menu-ac" aria-label="Menüyü aç" aria-expanded="false">
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></svg>
            </button>
            <nav class="ana-menu" aria-label="Ana menü">
                <a class="menu-link @(aktifSayfa == "/Index" ? "aktif" : "")" asp-page="/Index"
                   aria-current="@(aktifSayfa == "/Index" ? "page" : null)">Ana Sayfa</a>
                <a class="menu-link" href="#">Müzayedeler</a>
            </nav>
            <partial name="_GirisPartial" />
        </div>
    </header>

    @await RenderSectionAsync("AltMenu", required: false)

    <main class="site-main">
        <div class="site-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container footer-ic">
            <div class="footer-ust">
                <div class="footer-sol">
                    <div class="logo logo-kucuk" role="img" aria-label="Açık Artırma Pazaryeri">
                        <svg class="logo-delik" aria-hidden="true" viewBox="0 0 24 60"><path fill-rule="evenodd" d="M24 0H9L0 9V51L9 60H24ZM9 30a4.5 4.5 0 1 0 9 0a4.5 4.5 0 1 0 -9 0Z" /></svg>
                        <span class="logo-govde" aria-hidden="true">Açık Artırma</span>
                        <span class="logo-kocan" aria-hidden="true">Pazaryeri</span>
                    </div>
                    <div class="mono">BLM4581 Ağ Tabanlı Teknolojiler ve Uygulamaları — Dönem Projesi</div>
                </div>
                <nav class="footer-menu" aria-label="Alt menü">
                    <a asp-page="/Index">Ana Sayfa</a>
                    <a href="#">Müzayedeler</a>
                    <a asp-page="/Hesap/Profil">Profilim</a>
                </nav>
            </div>
            <div class="footer-alt mono">
                <span>&copy; 2026 Kaan Yorgun</span>
                <a class="footer-link" href="https://github.com/kaany43/AcikArtirmaPazaryeri">GitHub</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
