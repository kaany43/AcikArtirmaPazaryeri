@page
@model AcikArtirmaPazaryeri.Pages.Satici.EkleModel
@using AcikArtirmaPazaryeri.Models
@{
    ViewData["Title"] = "Yeni İlan";
    var parcalar = AcikArtirmaPazaryeri.Pages.Satici.EkleModel.Parcalar;
    var parcaDurumlari = Html.GetEnumSelectList<ParcaDurumu>();
}

<div class="sayfa sayfa-sik">
    <div class="sayfa-basi">
        <a class="geri-link" asp-page="/Satici/Index">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
            İlanlarım
        </a>
        <h1 class="sayfa-baslik">Yeni İlan</h1>
    </div>

    @* data-arac-idleri: araç kategorilerinin virgülle ayrılmış id'leri. *@
    <form method="post" enctype="multipart/form-data" class="form-blok form-blok-genis" novalidate data-arac-idleri="@string.Join(",", Model.AracKategoriIdleri)">
        <div asp-validation-summary="ModelOnly" class="form-hata-ozet" role="alert"></div>

        <h2 class="bolum-baslik">İlan bilgileri</h2>

        <div class="alan">
            <label asp-for="Girdi.Baslik" class="alan-etiket">Başlık</label>
            <input asp-for="Girdi.Baslik" class="girdi" maxlength="100" autocomplete="off" />
            <span asp-validation-for="Girdi.Baslik" class="alan-hata"></span>
        </div>

        <div class="alan">
            <label asp-for="Girdi.Aciklama" class="alan-etiket">Açıklama</label>
            <textarea asp-for="Girdi.Aciklama" class="girdi" rows="5"></textarea>
            <span asp-validation-for="Girdi.Aciklama" class="alan-hata"></span>
        </div>

        <div class="alan-ikili">
            <div class="alan">
                <label for="kategori" class="alan-etiket">Kategori</label>
                <select asp-for="Girdi.KategoriId" asp-items="Model.Kategoriler" id="kategori" class="girdi">
                    <option value="">Kategori seçin</option>
                </select>
                <span asp-validation-for="Girdi.KategoriId" class="alan-hata"></span>
            </div>
            <div class="alan">
                <label for="urun-durumu" class="alan-etiket">Ürün durumu</label>
                <select asp-for="Girdi.UrunDurumu" asp-items="Html.GetEnumSelectList<UrunDurumu>()" id="urun-durumu" class="girdi"
                        data-az-kullanilmis="@((int)UrunDurumu.AzKullanilmis)"></select>
                <span asp-validation-for="Girdi.UrunDurumu" class="alan-hata"></span>
            </div>
        </div>

        <div class="alan">
            <label asp-for="Girdi.Sehir" class="alan-etiket">Şehir</label>
            <input asp-for="Girdi.Sehir" class="girdi" maxlength="50" />
            <span asp-validation-for="Girdi.Sehir" class="alan-hata"></span>
        </div>

        <h2 class="bolum-baslik">Fiyat ve süre</h2>

        <div class="alan-ikili">
            <div class="alan">
                <label asp-for="Girdi.BaslangicFiyati" class="alan-etiket">Başlangıç fiyatı (₺)</label>
                <input asp-for="Girdi.BaslangicFiyati" type="number" min="0" step="1" class="girdi" />
                <span asp-validation-for="Girdi.BaslangicFiyati" class="alan-hata"></span>
            </div>
            <div class="alan">
                <label asp-for="Girdi.MinimumArtis" class="alan-etiket">Minimum artış (₺)</label>
                <input asp-for="Girdi.MinimumArtis" type="number" min="0" step="1" class="girdi" />
                <span asp-validation-for="Girdi.MinimumArtis" class="alan-hata"></span>
            </div>
        </div>

        <div class="alan">
            <label asp-for="Girdi.RezervFiyati" class="alan-etiket">Rezerv fiyatı (₺) <span class="alan-etiket-not">boş bırakılabilir</span></label>
            <input asp-for="Girdi.RezervFiyati" type="number" min="0" step="1" class="girdi" />
            <span asp-validation-for="Girdi.RezervFiyati" class="alan-hata"></span>
        </div>

        <div class="alan-ikili">
            <div class="alan">
                <label asp-for="Girdi.BaslangicZamani" class="alan-etiket">Başlangıç zamanı</label>
                <input asp-for="Girdi.BaslangicZamani" type="datetime-local" class="girdi"
                       value="@(Model.Girdi.BaslangicZamani == default ? "" : Model.Girdi.BaslangicZamani.ToString("yyyy-MM-ddTHH:mm"))" />
                <span asp-validation-for="Girdi.BaslangicZamani" class="alan-hata"></span>
            </div>
            <div class="alan">
                <label asp-for="Girdi.BitisZamani" class="alan-etiket">Bitiş zamanı</label>
                <input asp-for="Girdi.BitisZamani" type="datetime-local" class="girdi"
                       value="@(Model.Girdi.BitisZamani == default ? "" : Model.Girdi.BitisZamani.ToString("yyyy-MM-ddTHH:mm"))" />
                <span asp-validation-for="Girdi.BitisZamani" class="alan-hata"></span>
            </div>
        </div>

        <h2 class="bolum-baslik">Fotoğraflar</h2>

        <div class="alan">
            <label asp-for="Fotograflar" class="alan-etiket">Fotoğraflar</label>
            <input asp-for="Fotograflar" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="girdi" />
            <span class="alan-not">En fazla 10 fotoğraf, her biri en fazla 5 MB. İlk fotoğraf kapak olur.</span>
            <span asp-validation-for="Fotograflar" class="alan-hata"></span>
            <div id="foto-onizleme" class="foto-onizleme"></div>
        </div>

        <div id="arac-bolumu" class="form-blok form-blok-genis" hidden>
            <h2 class="bolum-baslik">Araç bilgileri</h2>

            <div class="alan-ikili">
                <div class="alan">
                    <label asp-for="Girdi.SasiNo" class="alan-etiket">Şasi numarası</label>
                    <input asp-for="Girdi.SasiNo" class="girdi" maxlength="17" autocomplete="off" />
                    <span asp-validation-for="Girdi.SasiNo" class="alan-hata"></span>
                    <button type="button" id="vin-doldur" class="dugme dugme-cerceve">Şasi no ile doldur</button>
                    <span id="vin-durum" class="alan-not" role="status"></span>
                </div>
                <div class="alan">
                    <label asp-for="Girdi.Plaka" class="alan-etiket">Plaka</label>
                    <input asp-for="Girdi.Plaka" class="girdi" maxlength="10" autocomplete="off" />
                    <span asp-validation-for="Girdi.Plaka" class="alan-hata"></span>
                </div>
            </div>

            <div class="alan-ikili">
                <div class="alan">
                    <label for="marka" class="alan-etiket">Marka</label>
                    <select asp-for="Girdi.MarkaId" id="marka" asp-items="Model.Markalar" class="girdi">
                        <option value="">Marka seçin</option>
                    </select>
                    <span asp-validation-for="Girdi.MarkaId" class="alan-hata"></span>
                </div>
                <div class="alan">
                    <label for="model" class="alan-etiket">Model</label>
                    <select asp-for="Girdi.AracModeliId" id="model" asp-items="Model.Modeller" class="girdi" disabled="@(Model.Girdi.MarkaId == null)">
                        <option value="">@(Model.Girdi.MarkaId == null ? "Önce marka seçin" : "Model seçin")</option>
                    </select>
                    <span asp-validation-for="Girdi.AracModeliId" class="alan-hata"></span>
                </div>
            </div>

            <div class="alan-ikili">
                <div class="alan">
                    <label asp-for="Girdi.Yil" class="alan-etiket">Yıl</label>
                    <input asp-for="Girdi.Yil" class="girdi" />
                    <span asp-validation-for="Girdi.Yil" class="alan-hata"></span>
                </div>
                <div class="alan">
                    <label asp-for="Girdi.Km" class="alan-etiket">Kilometre</label>
                    <input asp-for="Girdi.Km" class="girdi" />
                    <span asp-validation-for="Girdi.Km" class="alan-hata"></span>
                </div>
            </div>

            <div class="alan-ikili">
                <div class="alan">
                    <label asp-for="Girdi.YakitTuru" class="alan-etiket">Yakıt türü</label>
                    <select asp-for="Girdi.YakitTuru" asp-items="Html.GetEnumSelectList<YakitTuru>()" class="girdi">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Girdi.YakitTuru" class="alan-hata"></span>
                </div>
                <div class="alan">
                    <label asp-for="Girdi.VitesTuru" class="alan-etiket">Vites türü</label>
                    <select asp-for="Girdi.VitesTuru" asp-items="Html.GetEnumSelectList<VitesTuru>()" class="girdi">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Girdi.VitesTuru" class="alan-hata"></span>
                </div>
            </div>

            <div class="alan-ikili">
                <div class="alan">
                    <label asp-for="Girdi.KasaTipi" class="alan-etiket">Kasa tipi</label>
                    <select asp-for="Girdi.KasaTipi" asp-items="Html.GetEnumSelectList<KasaTipi>()" class="girdi">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Girdi.KasaTipi" class="alan-hata"></span>
                </div>
                <div class="alan">
                    <label asp-for="Girdi.Renk" class="alan-etiket">Renk</label>
                    <input asp-for="Girdi.Renk" class="girdi" maxlength="50" />
                    <span asp-validation-for="Girdi.Renk" class="alan-hata"></span>
                </div>
            </div>

            <div class="alan">
                <label asp-for="Girdi.Paket" class="alan-etiket">Paket</label>
                <input asp-for="Girdi.Paket" class="girdi" />
                <span asp-validation-for="Girdi.Paket" class="alan-hata"></span>
            </div>

            <h2 class="bolum-baslik">Ekspertiz</h2>

            <div class="alan-ikili">
                @for (var i = 0; i < parcalar.Length; i++)
                {
                    var secili = i < Model.Girdi.Ekspertiz.Count ? Model.Girdi.Ekspertiz[i] : ParcaDurumu.Orijinal;
                    var secenekler = new SelectList(parcaDurumlari, "Value", "Text", ((int)secili).ToString());
                    <div class="alan">
                        <label for="ekspertiz-@i" class="alan-etiket">@parcalar[i]</label>
                        <select id="ekspertiz-@i" name="Girdi.Ekspertiz[@i]" asp-items="secenekler" class="girdi"></select>
                    </div>
                }
            </div>
        </div>

        <div class="dugme-grup">
            <button type="submit" class="dugme dugme-sari">Taslak olarak kaydet</button>
            <a class="dugme dugme-cerceve" asp-page="/Satici/Index">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const form = document.querySelector("form[data-arac-idleri]");
        const aracIdleri = form.dataset.aracIdleri.split(",").filter(Boolean);
        const kategori = document.getElementById("kategori");
        const aracBolumu = document.getElementById("arac-bolumu");
        const urunDurumu = document.getElementById("urun-durumu");
        const azKullanilmis = urunDurumu.querySelector(`option[value="${urunDurumu.dataset.azKullanilmis}"]`);
        const marka = document.getElementById("marka");
        const model = document.getElementById("model");
        const fotograflar = document.getElementById("Fotograflar");
        const fotoOnizleme = document.getElementById("foto-onizleme");
        const sasiNo = document.getElementById("Girdi_SasiNo");
        const vinDoldur = document.getElementById("vin-doldur");
        const vinDurum = document.getElementById("vin-durum");

        function kategoriyeGoreGuncelle() {
            const aracMi = aracIdleri.includes(kategori.value);
            aracBolumu.hidden = !aracMi;
            // Gizli bölümdeki şasi no gönderilmez; araç dışı ilanda görünmeyen bir hataya yol açmasın.
            sasiNo.disabled = !aracMi;
            azKullanilmis.hidden = aracMi;
            azKullanilmis.disabled = aracMi;
            if (aracMi && urunDurumu.value === azKullanilmis.value) {
                urunDurumu.selectedIndex = 0;
            }
        }

        function modelSecenegiEkle(deger, yazi) {
            const secenek = document.createElement("option");
            secenek.value = deger;
            secenek.textContent = yazi;
            model.append(secenek);
        }

        async function modelleriGetir() {
            const markaId = marka.value;
            model.replaceChildren();
            model.disabled = true;
            if (!markaId) {
                modelSecenegiEkle("", "Önce marka seçin");
                return;
            }
            modelSecenegiEkle("", "Model seçin");
            const yanit = await fetch(`?handler=Modeller&markaId=${markaId}`);
            const modeller = await yanit.json();
            if (marka.value !== markaId) {
                return;
            }
            modeller.forEach(m => modelSecenegiEkle(m.id, m.ad));
            model.disabled = false;
        }

        // GetEnumSelectList seçeneklerin değerini sayı yazar; sunucudan gelen ad, seçeneğin yazısıyla eşleştirilir.
        function secenegiYazidanSec(liste, yazi) {
            const secenek = Array.from(liste.options).find(o => o.text === yazi);
            if (secenek) {
                liste.value = secenek.value;
            }
        }

        async function sasiNoIleDoldur() {
            vinDoldur.disabled = true;
            vinDurum.textContent = "Sorgulanıyor...";
            try {
                const yanit = await fetch(`?handler=VinCoz&sasiNo=${encodeURIComponent(sasiNo.value)}`);
                const sonuc = await yanit.json();
                if (!sonuc.basarili) {
                    vinDurum.textContent = sonuc.mesaj;
                    return;
                }
                if (sonuc.yil) {
                    document.getElementById("Girdi_Yil").value = sonuc.yil;
                }
                secenegiYazidanSec(document.getElementById("Girdi_YakitTuru"), sonuc.yakit);
                secenegiYazidanSec(document.getElementById("Girdi_VitesTuru"), sonuc.vites);
                marka.value = sonuc.markaId ?? "";
                await modelleriGetir();
                if (sonuc.modelId) {
                    model.value = sonuc.modelId;
                }
                if (!sonuc.markaId) {
                    vinDurum.textContent = `Marka listede yok: ${sonuc.marka}`;
                } else if (!sonuc.modelId) {
                    vinDurum.textContent = `Model listede yok: ${sonuc.marka} ${sonuc.model ?? ""}`;
                } else {
                    vinDurum.textContent = `Bulundu: ${sonuc.yil ?? ""} ${sonuc.marka} ${sonuc.model}`;
                }
            } catch {
                vinDurum.textContent = "Şasi numarası çözülemedi, bilgileri elle girin.";
            } finally {
                vinDoldur.disabled = false;
            }
        }

        function onizlemeyiGuncelle() {
            fotoOnizleme.replaceChildren();
            Array.from(fotograflar.files).forEach((dosya, i) => {
                const kutu = document.createElement("div");
                kutu.className = "foto-kutu";
                const resim = document.createElement("img");
                resim.alt = dosya.name;
                resim.src = URL.createObjectURL(dosya);
                resim.addEventListener("load", () => URL.revokeObjectURL(resim.src));
                kutu.append(resim);
                if (i === 0) {
                    const rozet = document.createElement("span");
                    rozet.className = "rozet rozet-sari foto-kapak";
                    rozet.textContent = "Kapak";
                    kutu.append(rozet);
                }
                fotoOnizleme.append(kutu);
            });
        }

        kategori.addEventListener("change", kategoriyeGoreGuncelle);
        marka.addEventListener("change", modelleriGetir);
        fotograflar.addEventListener("change", onizlemeyiGuncelle);
        vinDoldur.addEventListener("click", sasiNoIleDoldur);
        kategoriyeGoreGuncelle();
    </script>
}
