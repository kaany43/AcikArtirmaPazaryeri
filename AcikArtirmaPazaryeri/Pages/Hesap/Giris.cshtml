@page
@model AcikArtirmaPazaryeri.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="sayfa-baslik">Giriş Yap</h1>
        <p class="sayfa-aciklama">Hesabına giriş yaparak müzayedelere katıl.</p>

        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Girdi.Eposta" class="form-label"></label>
                    <input asp-for="Girdi.Eposta" type="email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Girdi.Eposta" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Girdi.Sifre" class="form-label"></label>
                    <input asp-for="Girdi.Sifre" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Girdi.Sifre" class="text-danger small"></span>
                </div>
                <div class="col-12 form-check">
                    <input asp-for="Girdi.BeniHatirla" class="form-check-input" />
                    <label asp-for="Girdi.BeniHatirla" class="form-check-label"></label>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning w-100 fw-semibold">Giriş Yap</button>
                </div>
            </div>
        </form>

        <p class="mt-3 text-center small">Hesabın yok mu? <a asp-page="/Hesap/Kayit">Kayıt ol</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
