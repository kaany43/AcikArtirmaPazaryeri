@page
@model AcikArtirmaPazaryeri.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="sayfa">
    <div class="sayfa-basi">
        <h1 class="sayfa-baslik">Giriş Yap</h1>
        <p class="sayfa-aciklama">Hesabına giriş yaparak müzayedelere katıl.</p>
    </div>

    <div class="iki-sutun">
        <form method="post" class="form-blok form-blok-dar" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="form-hata-ozet" role="alert"></div>

            <div class="alan">
                <label asp-for="Girdi.Eposta" class="alan-etiket"></label>
                <input asp-for="Girdi.Eposta" type="email" class="girdi" autocomplete="email" />
                <span asp-validation-for="Girdi.Eposta" class="alan-hata"></span>
            </div>

            <div class="alan">
                <label asp-for="Girdi.Sifre" class="alan-etiket"></label>
                <div class="girdi-grup">
                    <input asp-for="Girdi.Sifre" class="girdi" autocomplete="current-password" />
                    <button type="button" class="goster-dugme" data-sifre-goster="Girdi_Sifre" aria-label="Şifreyi göster">Göster</button>
                </div>
                <span asp-validation-for="Girdi.Sifre" class="alan-hata"></span>
            </div>

            <label class="onay-satir">
                <input asp-for="Girdi.BeniHatirla" class="onay-kutu" />
                <span>Beni hatırla</span>
            </label>

            <button type="submit" class="dugme dugme-sari dugme-tam">Giriş Yap</button>
        </form>

        <aside class="yan-panel" aria-labelledby="hesabin-yok-mu">
            <h2 class="yan-baslik" id="hesabin-yok-mu">Hesabın yok mu?</h2>
            <p class="yan-metin">Kayıt olmak bir dakika sürer. Her üye alıcı olarak başlar; satış yapmak istersen satıcı hesabını profilinden açarsın.</p>
            <a class="dugme dugme-cerceve" asp-page="/Hesap/Kayit">Kayıt Ol</a>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
