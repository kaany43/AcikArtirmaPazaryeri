@page
@model AcikArtirmaPazaryeri.Pages.Hesap.ProfilModel
@{
    ViewData["Title"] = "Profilim";
    var yoneticiMi = User.IsInRole("Yonetici");
}

<div class="sayfa">
    <div class="sayfa-basi">
        <span class="ust-etiket">Profilim</span>
        <h1 class="sayfa-baslik">@Model.AktifKullanici.Ad @Model.AktifKullanici.Soyad</h1>
        <div class="rozet-grup">
            @if (yoneticiMi)
            {
                <span class="rozet rozet-siyah">Yönetici</span>
            }
            else
            {
                <span class="rozet">Alıcı</span>
            }
            @if (Model.SaticiMi)
            {
                <span class="rozet rozet-sari">Satıcı</span>
            }
        </div>
    </div>

    <div class="iki-sutun">
        <section class="profil-bilgi" aria-labelledby="hesap-bilgileri">
            <h2 class="bolum-baslik" id="hesap-bilgileri">Hesap bilgileri</h2>
            <dl class="bilgi-listesi">
                <div class="bilgi-satir">
                    <dt>Ad Soyad</dt>
                    <dd>@Model.AktifKullanici.Ad @Model.AktifKullanici.Soyad</dd>
                </div>
                <div class="bilgi-satir">
                    <dt>E-posta</dt>
                    <dd>@Model.AktifKullanici.Email</dd>
                </div>
                <div class="bilgi-satir">
                    <dt>Firma</dt>
                    <dd>@(Model.AktifKullanici.FirmaAdi ?? "—")</dd>
                </div>
                <div class="bilgi-satir">
                    <dt>Hesap türü</dt>
                    <dd>@(yoneticiMi ? "Yönetici" : Model.SaticiMi ? "Alıcı ve satıcı" : "Alıcı")</dd>
                </div>
            </dl>
        </section>

        <section class="satici-panel" aria-labelledby="satici-baslik">
            @if (Model.SaticiMi)
            {
                <h2 class="yan-baslik" id="satici-baslik">Satıcı hesabın aktif</h2>
                <p class="yan-metin">Müzayede açma özelliği eklendiğinde buradan ilan verebileceksin. Alıcı hesabın da açık kalır.</p>
                @if (Model.AktifKullanici.GuvenilirSaticiMi)
                {
                    <div>
                        <span class="guvenilir-evet">Güvenilir satıcı</span>
                    </div>
                }
            }
            else
            {
                <h2 class="yan-baslik" id="satici-baslik">Satıcı ol</h2>
                <p class="yan-metin">Satıcı olduğunda kendi ürünlerin için müzayede açabilirsin. Alıcı hesabın da açık kalır.</p>

                <form method="post" asp-page-handler="SaticiOl">
                    <div class="alan">
                        <label asp-for="FirmaAdi" class="alan-etiket">Firma adı <span class="alan-etiket-not">(isteğe bağlı)</span></label>
                        <input asp-for="FirmaAdi" class="girdi" maxlength="100" autocomplete="organization" aria-describedby="firma-not" />
                        <span class="alan-not" id="firma-not">Galeri veya mağazaysan yaz; bireysel satıcıysan boş bırak.</span>
                    </div>
                    <button type="submit" class="dugme dugme-sari">Satıcı Ol</button>
                </form>
            }
        </section>
    </div>
</div>
