@page
@model AcikArtirmaPazaryeri.Pages.Yonetim.Kategoriler.IndexModel
@{
    ViewData["Title"] = "Kategoriler";
    var anaSayisi = Model.Kategoriler.Count(k => k.UstKategoriId == null);
    var altSayilari = Model.Kategoriler
        .Where(k => k.UstKategoriId != null)
        .GroupBy(k => k.UstKategoriId!.Value)
        .ToDictionary(g => g.Key, g => g.Count());
}

@section AltMenu {
    <partial name="_YonetimMenu" />
}

<div class="sayfa sayfa-sik">
    <div class="sayfa-basi-satir">
        <div class="sayfa-basi">
            <h1 class="sayfa-baslik">Kategoriler</h1>
            <p class="sayfa-aciklama">Ana kategoriler gri satırda, alt kategorileri hemen altında girintili listelenir.</p>
        </div>
        <a class="dugme dugme-sari" asp-page="Ekle">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
            Yeni kategori
        </a>
    </div>

    <div class="istatistikler">
        <div class="istatistik">
            <span class="istatistik-sayi">@Model.Kategoriler.Count</span>
            <span class="istatistik-etiket">Toplam</span>
        </div>
        <div class="istatistik">
            <span class="istatistik-sayi">@anaSayisi</span>
            <span class="istatistik-etiket">Ana kategori</span>
        </div>
        <div class="istatistik">
            <span class="istatistik-sayi">@(Model.Kategoriler.Count - anaSayisi)</span>
            <span class="istatistik-etiket">Alt kategori</span>
        </div>
        <div class="istatistik">
            <span class="istatistik-sayi">@Model.Kategoriler.Count(k => k.AracKategorisiMi)</span>
            <span class="istatistik-etiket">Araç kategorisi</span>
        </div>
        <div class="istatistik">
            <span class="istatistik-sayi">@Model.Kategoriler.Count(k => k.OtomatikOnayAcikMi)</span>
            <span class="istatistik-etiket">Otomatik onay açık</span>
        </div>
    </div>

    @if (Model.Kategoriler.Count == 0)
    {
        <p class="not-kutu">Henüz kategori yok.</p>
    }
    else
    {
        <div class="tablo-kap">
            <table class="veri-tablosu">
                <thead>
                    <tr>
                        <th class="sutun-no">#</th>
                        <th>Kategori</th>
                        <th style="width: 110px">Alt kat.</th>
                        <th style="width: 110px">Araç</th>
                        <th style="width: 140px">Otomatik onay</th>
                        <th class="sutun-sag" style="width: 160px">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kategoriler)
                    {
                        var anaMi = k.UstKategoriId == null;
                        <tr class="@(anaMi ? "ana-satir" : null)">
                            <td class="sutun-no hucre-mono">@k.KategoriId</td>
                            @if (anaMi)
                            {
                                <td class="ana-kategori-ad">@k.KategoriAdi</td>
                                <td class="hucre-mono">@(altSayilari.GetValueOrDefault(k.KategoriId))</td>
                            }
                            else
                            {
                                <td>
                                    <span class="alt-kategori-ad">
                                        <span class="agac-isaret" aria-hidden="true">└</span>
                                        <span>@k.KategoriAdi</span>
                                    </span>
                                </td>
                                <td class="hucre-mono">—</td>
                            }
                            <td>
                                @if (k.AracKategorisiMi)
                                {
                                    <span class="rozet rozet-siyah">Araç</span>
                                }
                                else
                                {
                                    <span class="bos-deger">—</span>
                                }
                            </td>
                            <td>
                                @if (k.OtomatikOnayAcikMi)
                                {
                                    <span class="rozet rozet-sari">Açık</span>
                                }
                                else
                                {
                                    <span class="soluk-yazi">Kapalı</span>
                                }
                            </td>
                            <td class="sutun-sag">
                                <span class="tablo-islemler">
                                    <a class="tablo-link" asp-page="Duzenle" asp-route-id="@k.KategoriId">Düzenle</a>
                                    <a class="tablo-link tablo-link-kirmizi" asp-page="Sil" asp-route-id="@k.KategoriId">Sil</a>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
