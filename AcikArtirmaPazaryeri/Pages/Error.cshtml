@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="hata-sayfa">
    <div class="hata-gorsel">
        <partial name="_HataCentik" model="@("500")" />
    </div>
    <div class="hata-metin">
        <span class="hata-etiket">HATA 500</span>
        <h1 class="hata-baslik">Çekiç biraz sert indi</h1>
        <p class="sayfa-aciklama">Bizim tarafta bir şey kırıldı. Birkaç dakika sonra tekrar dene; sorun sürerse istek numarasıyla bildir.</p>
        @if (Model.ShowRequestId)
        {
            <div class="istek-kutu">
                <span>İstek no</span>
                <code>@Model.RequestId</code>
            </div>
        }
        <div class="dugme-grup">
            <a class="dugme dugme-sari" href="">Tekrar dene</a>
        </div>
    </div>
</div>
