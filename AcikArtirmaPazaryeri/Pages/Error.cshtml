@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="hata-sayfa">
    <div class="hata-gorsel" aria-hidden="true">
        <span class="hata-kod">500</span>
        <div class="hata-serit hata-serit-beyaz"></div>
    </div>
    <div class="hata-metin">
        <span class="ust-etiket">Sunucu hatası</span>
        <h1 class="hata-baslik">Bir şeyler ters gitti</h1>
        <p class="sayfa-aciklama">İsteğin işlenirken bir hata oluştu. Sayfayı yenilemeyi dene; sorun sürerse aşağıdaki istek numarasıyla bildir.</p>
        @if (Model.ShowRequestId)
        {
            <div class="istek-kutu">
                <span>İstek no</span>
                <code>@Model.RequestId</code>
            </div>
        }
        <div class="dugme-grup">
            <a class="dugme dugme-sari" asp-page="/Index">Ana sayfaya dön</a>
        </div>
    </div>
</div>
